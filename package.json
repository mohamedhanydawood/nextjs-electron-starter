{
  "name": "nextjs-electron-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build-electron/main.js",
  "scripts": {
    "dev": "concurrently \"cross-env NODE_ENV=development next dev\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "electron-dev": "concurrently \"tsc -p electron/tsconfig.json --watch\" \"cross-env NODE_ENV=development electron .\"",
    "build": "next build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint ."
  },
  "description": "A Next.js and Electron desktop application starter",
  "author": "Your Name",
  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "tar": "^7.5.7",
    "ajv": "^6.14.0",
    "@xmldom/xmldom": "^0.8.12",
    "brace-expansion": "^1.1.13",
    "@isaacs/brace-expansion": "^5.0.1",
    "minimatch": "^3.1.3",
    "flatted": "^3.4.0",
    "diff": "^4.0.4",
    "@tootallnate/once": "^3.0.1",
    "postcss": "^8.5.10",
    "picomatch": "^3.0.0",
    "ip-address": "^10.2.0",
    "lodash": "^4.17.21"
  },
  "build": {
    "appId": "com.nextjs.electronstarter",
    "productName": "NextJSElectronStarter",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    }
  }
}
